#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: sarcasm, threat
#, fuzzy
#: lang/en.txt
msgctxt "77"
msgid "\"Hmm... another mortal at my doorstep...\""
msgstr "\"Гм... ще один смертний на моєму порозі...\""

#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: sarcasm
#, fuzzy
#: lang/en.txt
msgctxt "78"
msgid "\"Ahh, another one joins the fray...\""
msgstr "\"А-а, ще один вступає в бій...\""

#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: sarcasm
#, fuzzy
#: lang/en.txt
msgctxt "79"
msgid "\"Hmm... someone new...\""
msgstr "\"Гм... хтось новенький...\""

#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: threat
#, fuzzy
#: lang/en.txt
msgctxt "80"
msgid "\"You'd best not linger for much longer, mortal.\""
msgstr "\"Не баріться тут надто довго, смертний.\""

#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: threat, sarcasm
#, fuzzy
#: lang/en.txt
msgctxt "81"
msgid "\"What a pity if you should be here when He arrives...\""
msgstr "\"Яка буде прикрість, якщо ви ще будете тут, коли Він прийде...\""

#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: threat
#, fuzzy
#: lang/en.txt
msgctxt "82"
msgid "\"You would be wise to abandon this place soon, mortal.\""
msgstr "\"Було б мудро невдовзі покинути це місце, смертний.\""

#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: sarcasm
#, fuzzy
#: lang/en.txt
msgctxt "83"
msgid "\"Hmm... this one's still alive.\""
msgstr "\"Гм... цей іще живий.\""

#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: sarcasm
#, fuzzy
#: lang/en.txt
msgctxt "84"
msgid "\"Hmm, so you've made it this far...\""
msgstr "\"Гм, то ви дісталися аж сюди...\""

#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: sarcasm
#, fuzzy
#: lang/en.txt
msgctxt "85"
msgid "\"What do you hope to accomplish down here, mortal?\""
msgstr "\"Чого ви сподіваєтеся тут досягти, смертний?\""

#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: threat
#, fuzzy
#: lang/en.txt
msgctxt "86"
msgid "\"You know nothing of the power that I've found here...\""
msgstr "\"Ви й гадки не маєте про силу, яку я тут знайшов...\""

#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: threat, command
#, fuzzy
#: lang/en.txt
msgctxt "87"
msgid "\"Face me if you dare, mortal. You will not survive.\""
msgstr "\"Станьте до бою, якщо насмілитеся, смертний. Вам не вижити.\""

#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: threat, command
#, fuzzy
#: lang/en.txt
msgctxt "88"
msgid "\"Meet me in my lair, mortal, and I will show you the meaning of pain.\""
msgstr "\"Зустріньтеся зі мною в моєму лігві, смертний, і я покажу вам, що таке біль.\""

#. репліки Барона Геркса, головного антагоніста: пихатий, зловісний, глузливий
#. тон: threat, excited
#, fuzzy
#: lang/en.txt
msgctxt "89"
msgid "\"Welcome to your doom, mortal!\""
msgstr "\"Ласкаво прошу до вашої погибелі, смертний!\""

