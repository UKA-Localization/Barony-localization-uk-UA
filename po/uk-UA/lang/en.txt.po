msgid "\"Did you know?\"\n\"Gnomes and trolls are best friends.\"\n\"It's true!\""
msgstr "«А ви знали?»\n«Гноми й тролі — найкращі друзі.»\n«Чиста правда!»"

#. репліки Шарура — розумної булави-артефакту: самовпевнений, саркастичний
#. сутності: Shopkeeper → Крамар
#. тон: joke, sarcasm
#, fuzzy
#: lang/en.txt
msgctxt "564"
msgid "\"Did you know?\"\n\"Shopkeepers really ARE magical geniuses.\"\n\"It's true!\""
msgstr "«А ви знали?»\n«Крамарі й справді Є магічними геніями.»\n«Чиста правда!»"

#. репліки Шарура — розумної булави-артефакту: самовпевнений, саркастичний
#. сутності: Troll → Троль
#. тон: joke
#, fuzzy
#: lang/en.txt
msgctxt "565"
msgid "\"Did you know?\"\n\"Trolls would rather just be left alone.\"\n\"It's true!\""
msgstr "«А ви знали?»\n«Тролі воліли б, аби їх просто не чіпали.»\n«Чиста правда!»"

#. репліки Шарура — розумної булави-артефакту: самовпевнений, саркастичний
#. сутності: Minotaur → Мінотавр
#, fuzzy
#: lang/en.txt
msgctxt "566"
