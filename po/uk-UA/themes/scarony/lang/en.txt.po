#. blank lines are ignored
#. тон: joke, threat
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "538"
msgid "\"Did you know?\"\n\"I ate his liver with some fava beans and a nice chianti.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Я з'їв його печінку з бобами й добрим к'янті.\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: joke
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "539"
msgid "\"Did you know?\"\n\"I'm your number one fan.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Я ваша найпалкіша шанувальниця.\"\n\"Це правда!\""

#. blank lines are ignored
#. сутності: Blood → кров
#. тон: threat, solemn
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "540"
msgid "\"Did you know?\"\n\"What is innocent blood if not for shedding?\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Навіщо невинна кров, як не для пролиття?\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: fear
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "541"
msgid "\"Did you know?\"\n\"I see dead people.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Я бачу мертвих людей.\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: threat
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "542"
msgid "\"Did you know?\"\n\"I know what you did last summer.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Я знаю, що ви зробили минулого літа.\"\n\"Це правда!\""

#. blank lines are ignored
#. сутності: boogeyman → бабай
#. тон: threat
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "543"
msgid "\"Did you know?\"\n\"You can't kill the boogeyman.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Бабая не вбити.\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: threat, sarcasm
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "544"
msgid "\"Did you know?\"\n\"I guess everyone's entitled to one good scare.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Гадаю, кожен заслуговує на добрий переляк.\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: threat, solemn
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "545"
msgid "\"Did you know?\"\n\"Evil is real.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Зло існує.\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: command, threat
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "546"
msgid "\"Did you know?\"\n\"You should never say 'I'll be right back'.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Ніколи не кажіть: 'Я зараз повернуся'.\"\n\"Це правда!\""

#. blank lines are ignored
#. сутності: soul → душа
#. тон: threat
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "547"
msgid "\"Did you know?\"\n\"We'll tear your soul apart.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Ми розірвемо вашу душу.\"\n\"Це правда!\""

#. blank lines are ignored
#. сутності: Demon → демон, Angel → ангел
#. тон: solemn, threat
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "548"
msgid "\"Did you know?\"\n\"Angels to some, demons to others.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Для одних — ангели, для інших — демони.\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: threat, command
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "549"
msgid "\"Did you know?\"\n\"Save your breath for screaming.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Бережіть подих для крику.\"\n\"Це правда!\""

#. blank lines are ignored
#. сутності: asleep → сон
#. тон: command, threat, fear
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "550"
msgid "\"Did you know?\"\n\"Whatever you do, don't fall asleep.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Що б ви не робили — не засинайте.\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: joke, threat
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "551"
msgid "\"Did you know?\"\n\"I'm into murders and executions, mostly.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Я здебільшого займаюся вбивствами і стратами.\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: joke, threat
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "552"
msgid "\"Did you know?\"\n\"My family's always been in meat.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Моя родина завжди мала справу з м'ясом.\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: rude, sarcasm
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "553"
msgid "\"Did you know?\"\n\"You're a regular barynard exhibit.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Та ви справжній експонат баронського звіринця.\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: sarcasm, joke
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "554"
msgid "\"Did you know?\"\n\"Psychos do not explode when sunlight hits them.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Психи не вибухають від сонячного світла.\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: sarcasm
#, fuzzy
#: themes/scarony/lang/en.txt
msgctxt "555"
msgid "\"Did you know?\"\n\"I'm sure it's a lot scarier at night.\"\n\"It's true!\""
msgstr "\"Чи знали ви?\"\n\"Уночі тут, певно, набагато страшніше.\"\n\"Це правда!\""

#. blank lines are ignored
#. тон: joke
#, fuzzy
